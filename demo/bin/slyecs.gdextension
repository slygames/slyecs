[configuration]

entry_symbol = "slyecs_library_init"
compatibility_minimum = "4.5"
reloadable = true

[icons]
;NodeECS = "res://addons/slyecs/icons/gear_2.svg"
NodeECS = "res://icons/gear_2.svg"
Ecs = "res://icons/animation_gear.svg"
Ability = "res://icons/inverse_gear_1.svg"
Archetype = "res://icons/inverse_gear_2.svg"
Attribute = "res://icons/inverse_gear_2.svg"
;Tags = "res://icons/Marker.svg"



[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
macos.single.debug = "./macos/libslyecs.macos.template_debug.dylib"
macos.double.debug = "./macos/libslyecs.macos.template_debug.double.dylib"
macos.single.release = "./macos/libslyecs.macos.template_release.dylib"
macos.double.release = "./macos/libslyecs.macos.template_debug.double.dylib"

ios.arm64.single.debug = "./ios/libslyecs.ios.template_debug.arm64.dylib"
ios.arm64.double.debug = "./ios/libslyecs.ios.template_debug.arm64.double.dylib"
ios.arm64.single.release = "./ios/libslyecs.ios.template_release.arm64.dylib"
ios.arm64.double.release = "./ios/libslyecs.ios.template_release.arm64.double.dylib"

windows.x86_32.single.debug = "./windows/slyecs.windows.template_debug.x86_32.dll"
windows.x86_32.double.debug = "./windows/slyecs.windows.template_debug.x86_32.double.dll"
windows.x86_32.single.release = "./windows/slyecs.windows.template_release.x86_32.dll"
windows.x86_32.double.release = "./windows/slyecs.windows.template_release.x86_32.double.dll"

windows.x86_64.single.debug = "./windows/slyecs.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./windows/slyecs.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.release = "./windows/slyecs.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./windows/slyecs.windows.template_release.x86_64.double.dll"

linux.x86_64.single.debug = "./linux/libslyecs.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./linux/libslyecs.linux.template_debug.x86_64.double.so"
linux.x86_64.single.release = "./linux/libslyecs.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./linux/libslyecs.linux.template_release.x86_64.double.so"

linux.arm64.single.debug = "./linux/libslyecs.linux.template_debug.arm64.so"
linux.arm64.double.debug = "./linux/libslyecs.linux.template_debug.arm64.double.so"
linux.arm64.single.release = "./linux/libslyecs.linux.template_release.arm64.so"
linux.arm64.double.release = "./linux/libslyecs.linux.template_release.arm64.double.so"

linux.rv64.single.debug = "./linux/libslyecs.linux.template_debug.rv64.so"
linux.rv64.double.debug = "./linux/libslyecs.linux.template_debug.rv64.double.so"
linux.rv64.single.release = "./linux/libslyecs.linux.template_release.rv64.so"
linux.rv64.double.release = "./linux/libslyecs.linux.template_release.rv64.double.so"

android.x86_64.single.debug = "./android/libslyecs.android.template_debug.x86_64.so"
android.x86_64.double.debug = "./android/libslyecs.android.template_debug.x86_64.double.so"
android.x86_64.single.release = "./android/libslyecs.android.template_release.x86_64.so"
android.x86_64.double.release = "./android/libslyecs.android.template_release.x86_64.double.so"

android.arm64.single.debug = "./android/libslyecs.android.template_debug.arm64.so"
android.arm64.double.debug = "./android/libslyecs.android.template_debug.arm64.double.so"
android.arm64.single.release = "./android/libslyecs.android.template_release.arm64.so"
android.arm64.double.release = "./android/libslyecs.android.template_release.arm64.double.so"

web.wasm32.single.debug = "./web/libslyecs.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "./web/libslyecs.web.template_release.wasm32.double.nothreads.wasm"
web.wasm32.single.release = "./web/libslyecs.web.template_release.wasm32.nothreads.wasm"
web.wasm32.double.release = "./web/libslyecs.web.template_release.wasm32.double.nothreads.wasm"
